# Postgres 直连（Prisma/Drizzle/迁移脚本用；<PROJECT_REF> 为项目 Reference ID）
DATABASE_URL=postgresql://postgres:<db-password>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Supabase Auth（OAuth 登录），不配置则为开发模式（免登录）
# 两种 key 命名均可：新版 publishable key 或传统 anon key
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-jwt>

# 瓦特引擎地址（服务端调用，浏览器不可见）
ENGINE_URL=http://localhost:8088
